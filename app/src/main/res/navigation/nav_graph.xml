<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.itanes.appturismo.res.fragments.SplashFragment"
        android:label="App Turismo">
        <action
            android:id="@+id/action_splash_to_tourList"
            app:destination="@id/tourListFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/tourListFragment"
        android:name="com.itanes.appturismo.res.fragments.TourListFragment"
        android:label="Tours">
        <action
            android:id="@+id/action_tourList_to_tourDetail"
            app:destination="@id/tourDetailFragment" />
        <action
            android:id="@+id/action_tourList_to_favorites"
            app:destination="@id/favoritesFragment" />
    </fragment>

    <fragment
        android:id="@+id/tourDetailFragment"
        android:name="com.itanes.appturismo.res.fragments.TourDetailFragment"
        android:label="Detalle del Tour">
        <argument
            android:name="tourId"
            app:argType="integer" />
        <action
            android:id="@+id/action_tourDetail_to_pointDetail"
            app:destination="@id/touristPointDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/touristPointDetailFragment"
        android:name="com.itanes.appturismo.res.fragments.TouristPointDetailFragment"
        android:label="Detalle del Punto">
        <argument
            android:name="touristPointId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.itanes.appturismo.res.fragments.FavoritesFragment"
        android:label="Favoritos">
        <action
            android:id="@+id/action_favorites_to_pointDetail"
            app:destination="@id/touristPointDetailFragment" />
        <action
            android:id="@+id/action_favorites_to_tourDetail"
            app:destination="@id/tourDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.itanes.appturismo.res.fragments.CalendarFragment"
        android:label="Calendario de Tours">
        <action
            android:id="@+id/action_calendar_to_tourDetail"
            app:destination="@id/tourDetailFragment" />
    </fragment>

</navigation>